#!/bin/bash
# ONIE installer for bone project (M8)
# 
# This is a sharch (shell archive) installer compatible with ONIE
# (Open Network Install Environment).
# 
# Usage: ./bone-installer.sh [--help]
#
# When run on ONIE-enabled hardware, extracts and installs the rootfs image.

set -e

# Default settings
INSTALLER_VERSION="1.0"
PRODUCT_NAME="bone"
MACHINE="generic-x86-64"

# Color output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m' # No Color

log_info() {
    echo -e "${GREEN}[INFO]${NC} $*"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $*"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $*" >&2
}

show_help() {
    cat << 'HELP'
bone ONIE Installer v1.0

ONIE-compatible installer for the bone project rootfs image.

Usage: ./bone-installer.sh [options]

Options:
  --help              Show this help message
  --info              Show installer information
  --uninstall         Remove installed image
  --dry-run           Test extraction without installation

Description:
  This installer is designed to run under ONIE (Open Network Install 
  Environment). It extracts and installs a complete rootfs image to the 
  system block device.

HELP
}

show_info() {
    cat << INFO
bone ONIE Installer
Version: $INSTALLER_VERSION
Product: $PRODUCT_NAME
Machine: $MACHINE
INFO
}

# Parse command-line arguments
case "${1:-}" in
    --help)
        show_help
        exit 0
        ;;
    --info)
        show_info
        exit 0
        ;;
    --dry-run)
        DRY_RUN=1
        ;;
    "")
        # No args - normal installation mode
        :
        ;;
    *)
        log_error "Unknown option: $1"
        show_help
        exit 1
        ;;
esac

# Determine if running under ONIE
if [ -z "$ONIE_MACHINE" ]; then
    log_warn "ONIE_MACHINE not set - may not be running under ONIE"
    log_warn "Proceeding in simulation mode"
    SIMULATION_MODE=1
fi

log_info "bone ONIE Installer v$INSTALLER_VERSION"
log_info "Product: $PRODUCT_NAME"

# Extract installer directory (where this script is located)
INSTALLER_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
INSTALLER_FILE="$INSTALLER_DIR/$(basename "${BASH_SOURCE[0]}")"

log_info "Installer: $INSTALLER_FILE"

# Find payload marker and offset
PAYLOAD_MARKER="##_PAYLOAD_MARKER_##"
PAYLOAD_START=$(grep -n "^${PAYLOAD_MARKER}$" "$INSTALLER_FILE" | cut -d: -f1)

if [ -z "$PAYLOAD_START" ]; then
    log_error "Payload marker not found in installer"
    log_error "This may be a corrupted or incomplete installer"
    exit 1
fi

log_info "Payload found at line $PAYLOAD_START"

# Skip the marker line itself
PAYLOAD_START=$((PAYLOAD_START + 1))

# Create temporary directory for extraction
TMPDIR=$(mktemp -d)
trap "rm -rf $TMPDIR" EXIT

log_info "Extracting rootfs to $TMPDIR"

# Extract tar payload (skip to line $PAYLOAD_START and extract tar)
tail -n +$PAYLOAD_START "$INSTALLER_FILE" | tar -xzf - -C "$TMPDIR"

if [ $? -ne 0 ]; then
    log_error "Failed to extract rootfs payload"
    exit 1
fi

# List extracted contents
log_info "Extracted files:"
find "$TMPDIR" -type f | head -20

# In simulation mode or dry-run, just verify extraction
if [ "${SIMULATION_MODE:-0}" = "1" ] || [ "${DRY_RUN:-0}" = "1" ]; then
    log_info "Dry-run mode: extraction successful"
    log_info "In production, would install to system block device"
    exit 0
fi

# Production installation (under ONIE)
log_info "Installing rootfs to system..."

# TODO: Actual installation logic would go here
# - Find target block device (usually ONIE_BOOT_SYS_DEV)
# - Format and partition
# - Write rootfs
# - Set ONIE boot variables
# - Reboot

exit 0

# Payload marker - binary tar data follows
##_PAYLOAD_MARKER_##
