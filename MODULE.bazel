module(
    name = "bone",
    version = "0.0.1",
    bazel_compatibility = [">=8.5.1", "<=8.5.1"],
)

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# Cosmopolitan toolchain: one APE binary carries x86_64 + aarch64.
http_archive(
    name = "cosmocc",
    build_file = "//toolchains:cosmocc.BUILD",
    sha256 = "85b8c37a406d862e656ad4ec14be9f6ce474c1b436b9615e91a55208aced3f44",
    urls = ["https://github.com/jart/cosmopolitan/releases/download/4.0.2/cosmocc-4.0.2.zip"],
)

http_archive(
    name = "busybox",
    build_file = "//third_party/busybox:busybox.BUILD",
    sha256 = "b8cc24c9574d809e7279c3be349795c5d5ceb6fdf19ca709f80cde50e47de314",
    strip_prefix = "busybox-1.36.1",
    urls = ["https://busybox.net/downloads/busybox-1.36.1.tar.bz2"],
)

# Linux kernel 6.1 LTS: cross-compile for x86_64 with cosmocc tools.
http_archive(
    name = "linux",
    build_file = "//third_party/linux:linux.BUILD",
    sha256 = "b9fd616facd6becfceef88b9be718d0f16625cab3fe81d11384802a7091e85ec",
    strip_prefix = "linux-6.1.62",
    urls = ["https://cdn.kernel.org/pub/linux/kernel/v6.x/linux-6.1.62.tar.xz"],
)
