"""Linux kernel source and artifacts."""

filegroup(
    name = "all_files",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "source",
    srcs = [
        "Makefile",
        "arch",
        "drivers",
        "fs",
        "include",
        "init",
        "kernel",
        "lib",
        "scripts",
        "tools",
    ],
    visibility = ["//visibility:public"],
)
